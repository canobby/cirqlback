# Cirqlback environment variables
# ---------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env   (bash)   |   Copy-Item .env.example .env  (PowerShell)
# `.env` is loaded at startup by dotenv (see server/index.ts) and is git-ignored.
# Never commit real secrets. VITE_* vars are exposed to the browser at build time.


# =============================================================
# REQUIRED TO BOOT (only DATABASE_URL is strictly required)
# =============================================================

# Postgres connection string. The app uses the Neon serverless (WebSocket)
# driver, so this must be a Neon database URL — a plain local Postgres will
# NOT work without swapping drivers. Create a free dev branch at neon.tech.
# Server throws "DATABASE_URL must be set" on startup if this is missing.
# Used by: server/db.ts, drizzle.config.ts
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# OpenAI API key. Needed for the AI features (insights, campaign suggestions,
# translation). The server now boots WITHOUT it — those endpoints just return a
# clear "must be set to use AI features" error until a key is provided.
# Used by: server/openai-service.ts, server/translation-service.ts
OPENAI_API_KEY=sk-...


# =============================================================
# FEATURE KEYS (server) — app boots without these, but the
# related feature returns an error/placeholder until set.
# =============================================================

# Google Maps key used by the server-side maps proxy (/api/maps/*).
# Used by: server/maps-proxy.ts
GOOGLE_MAPS_API_KEY=

# Stripe secret key for creating payment intents. Without it,
# POST /api/create-payment-intent returns a 400 "not configured".
# Used by: server/routes.ts
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_). Required for
# POST /api/stripe/webhook to verify events and activate subscriptions.
# Get it from the Stripe dashboard or `stripe listen` (Stripe CLI).
# Used by: server/routes.ts
STRIPE_WEBHOOK_SECRET=


# =============================================================
# CLIENT (browser) — must be prefixed VITE_ and are baked in at
# BUILD time. Set before `npm run build` / `npm run dev`.
# =============================================================

# Google Maps key for the client map components.
# Used by: client/src/components/map/google-map.tsx, client/src/pages/map-working.tsx
VITE_GOOGLE_MAPS_API_KEY=

# Stripe PUBLISHABLE (public) key for the checkout page. Publishable only —
# never put the secret key in a VITE_ variable (it ships to the browser).
# Used by: client/src/pages/checkout.tsx
VITE_STRIPE_PUBLIC_KEY=


# =============================================================
# OPTIONAL — sensible defaults; override only if needed
# =============================================================

# Server bind host/port. Defaults: HOST=127.0.0.1, PORT=5000.
# Set HOST=0.0.0.0 to expose on the network (e.g. for a container/deploy).
# Used by: server/index.ts
# HOST=127.0.0.1
# PORT=5000

# Comma-separated CORS allowlist. Defaults to the local dev origins.
# Add your production origin(s) here for deploy.
# Used by: server/index.ts
# CORS_ORIGINS=http://localhost:5000,https://app.cirqlback.com

# Secret used to sign session cookies. The server boots without it (using an
# insecure ephemeral secret + a warning), but set a long random value so
# sessions survive restarts. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by: server/auth.ts
SESSION_SECRET=

# Set automatically by the npm scripts (cross-env). Usually no need to set here.
# NODE_ENV=development


# =============================================================
# NOT YET USED — reserved for upcoming work, safe to leave blank
# =============================================================
# (none currently)
